{
  "name": "gals-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Build CSS cho prototype GALS (Tailwind CLI, không dùng CDN).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
