# Sao chép file này thành `.env` rồi điền giá trị thật.
# KHÔNG commit file `.env`.

# Khoá API Gemini — lấy tại https://aistudio.google.com/apikey
# Để trống thì ứng dụng vẫn chạy đầy đủ ở "chế độ demo ngoại tuyến"
# (AI trả lời bằng kịch bản dựng sẵn, mọi màn hình vẫn bấm được).
GEMINI_API_KEY=

# Tuỳ chọn. Bỏ trống để ứng dụng tự dò model flash mới nhất khi khởi động.
GEMINI_MODEL=

# Khoá ký cookie phiên đăng nhập. Đặt chuỗi ngẫu nhiên khi deploy.
SECRET_KEY=doi-chuoi-nay-khi-deploy
